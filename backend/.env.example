# Configurações do servidor
PORT=3000
NODE_ENV=development

# Neon/PostgreSQL: use a URL de conexão do projeto Neon
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/database?sslmode=require
DATABASE_SSL=true
DB_POOL_MAX=5

# Alternativa para execução local sem DATABASE_URL
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sintonia_tv
# DB_USER=postgres
# DB_PASSWORD=defina_localmente

# JWT e administrador: defina apenas no ambiente de deploy
JWT_SECRET=defina_um_segredo_forte_localmente
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=defina_localmente
